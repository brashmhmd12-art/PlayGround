# Copy to /etc/abrash-os.env (chmod 600) or deploy/abrash-os.env for compose.
# NEVER commit real secrets.
PORT=3001
# AI proxy (server-side only — never shipped to the browser):
# AI_KEY=sk-...
# AI_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
# Public domain for Caddy automatic HTTPS:
DOMAIN=localhost
# WebAuthn (Passkey) — must match your public origin:
# RP_ID=your-domain.com
# ORIGIN=https://your-domain.com
